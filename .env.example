# Local development only. Replace both secrets with independent random values.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-url-safe-64
JWT_SIGNING_KEY=change-me-generate-another-independent-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Kathmandu
LOG_LEVEL=INFO

# Media defaults to backend/media. Keep this directory private.
# DJANGO_MEDIA_ROOT=/absolute/path/to/private/media
VEHICLE_IMAGE_MAX_BYTES=8388608
VEHICLE_IMAGE_MAX_PIXELS=20000000
VEHICLE_IMAGE_MAX_EDGE=2048

# Limits quote calculation work; shared by quote and booking pricing services.
PRICING_MAX_RENTAL_DAYS=3660
AUTH_RATE_PRICING_QUOTE_IP_COUNT=60
AUTH_RATE_PRICING_QUOTE_IP_SECONDS=60

POSTGRES_DB=abound
POSTGRES_USER=abound
POSTGRES_PASSWORD=change-me-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_TEST_DB=test_abound

# Explicit browser origins; never use '*' for production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=False
PASSWORD_RESET_TIMEOUT=3600
AUTH_PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Local runserver delivers queued reset emails automatically. Disable when using a separate worker.
AUTH_RESET_DEV_WORKER=True
AUTH_RESET_RETRY_SECONDS=60
AUTH_RESET_MAX_ATTEMPTS=3
AUTH_RECORD_RETENTION_DAYS=30

# Email (registration verification codes, password reset links).
# Leave EMAIL_HOST_USER empty to keep mail in memory: nothing is sent and `manage.py check`
# shows warning accounts.W001. To deliver real email, fill in an SMTP account, e.g. Gmail
# (needs 2-Step Verification + an App Password from https://myaccount.google.com/apppasswords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_USE_SSL=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=abcdefghijklmnop   (16-letter App Password, not your Google password)
# Then verify with: .venv/bin/python manage.py sendtestemail you@example.com
EMAIL_HOST=localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
# Optional; defaults to "Abound Holidays <EMAIL_HOST_USER>" when SMTP is configured.
# DEFAULT_FROM_EMAIL=Abound Holidays <no-reply@example.com>

# Optional per-scope overrides: AUTH_RATE_<SCOPE>_COUNT and AUTH_RATE_<SCOPE>_SECONDS.
# Example scopes: LOGIN_IP, LOGIN_IDENTITY, REGISTER_IP, RESET_IP, RESET_IDENTITY.

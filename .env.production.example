# Reference only. Production reads injected variables, never this file automatically.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-url-safe-64
JWT_SIGNING_KEY=change-me-generate-another-independent-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_TIME_ZONE=Asia/Kathmandu
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
LOG_LEVEL=INFO

# Persistent private volume, shared by API instances and the image cleanup command.
DJANGO_MEDIA_ROOT=/var/lib/abound/media
VEHICLE_IMAGE_MAX_BYTES=8388608
VEHICLE_IMAGE_MAX_PIXELS=20000000
VEHICLE_IMAGE_MAX_EDGE=2048
VEHICLE_DOCUMENT_MAX_BYTES=15728640

# Notification delivery (optional; shown defaults). Required for the scheduled
# deliver_notifications / queue_*_reminders workers to behave sensibly in production.
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=3
BOOKING_REMINDER_DAYS_BEFORE=1
MAINTENANCE_REMINDER_DAYS_BEFORE=2

PRICING_MAX_RENTAL_DAYS=3660
AUTH_RATE_PRICING_QUOTE_IP_COUNT=60
AUTH_RATE_PRICING_QUOTE_IP_SECONDS=60

POSTGRES_DB=abound
POSTGRES_USER=abound_runtime
POSTGRES_PASSWORD=change-me-secret-manager-value
POSTGRES_HOST=database.example.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/run/secrets/postgres-ca.pem
POSTGRES_CONNECT_TIMEOUT=5

CORS_ALLOWED_ORIGINS=https://admin.example.com
CSRF_TRUSTED_ORIGINS=https://admin.example.com
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
AUTH_SESSION_DAYS=7
PASSWORD_RESET_TIMEOUT=3600
AUTH_PASSWORD_RESET_URL=https://app.example.com/reset-password
AUTH_RESET_RETRY_SECONDS=60
AUTH_RESET_MAX_ATTEMPTS=3
AUTH_RECORD_RETENTION_DAYS=30

# Required for the password-reset delivery worker.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me-secret-manager-value
DEFAULT_FROM_EMAIL=Abound Holidays <no-reply@example.com>
